{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    },
    "Console": {
      "FormatterName": "json"
    }
  },
  "AllowedHosts": "*",
  "YahooFinance": {
    "BaseAddress": "https://query1.finance.yahoo.com/",
    "UserAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
    "AttemptTimeout": "00:00:10",
    "TotalRequestTimeout": "00:00:30",
    "MaxRetryAttempts": 3
  },
  "DailySummaryCache": {
    "Expiration": "00:05:00"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PermitLimit": 60,
    "Window": "00:01:00"
  }
}
